# Copie este arquivo para .env.local e troque pelo numero real no formato internacional, sem +, espacos ou simbolos.
# Nunca coloque chaves reais no GitHub. Use .env.local localmente e variaveis de ambiente na Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Server-only. Nunca exponha esta chave no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo server-only usado pela Vercel para autenticar o heartbeat diario.
CRON_SECRET=

# Token temporario para proteger sincronizacao do painel admin.
AMARO_ADMIN_SYNC_TOKEN=

# Protecao server-side do painel administrativo.
AMARO_ADMIN_PASSWORD=
AMARO_ADMIN_SESSION_SECRET=

# Google Calendar OAuth (somente NEXT_PUBLIC_BUSINESS_TIME_ZONE e publica).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_ID=primary
NEXT_PUBLIC_BUSINESS_TIME_ZONE=America/Porto_Velho

# IA local opcional com Ollama (todas server-only).
AI_PROVIDER=disabled
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
AI_DAILY_LIMIT=50
AI_MAX_INPUT_CHARS=4000
AI_TIMEOUT_MS=30000
