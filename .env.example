# Copie este arquivo para .env.local e troque pelo numero real no formato internacional, sem +, espacos ou simbolos.
# Nunca coloque chaves reais no GitHub. Use .env.local localmente e variaveis de ambiente na Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Nunca exponha esta chave no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Token temporario para proteger sincronizacao do painel admin.
AMARO_ADMIN_SYNC_TOKEN=

NEXT_PUBLIC_WHATSAPP_NUMBER=5599999999999
